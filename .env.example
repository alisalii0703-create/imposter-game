# IMposter Pro — copy to .env and fill in. Never commit .env.
# Loaded automatically by `npm start`, `npm run stripe:setup` and friends.

# 1) Stripe secret key (sk_test_… while testing, sk_live_… for real money)
STRIPE_SECRET_KEY=

# 2) Filled in for you by `npm run stripe:setup` (a $9.90/month recurring price)
STRIPE_PRICE_ID=

# 3) From the webhook endpoint you create at:
#    https://<your-host>/api/stripe/webhook  (events: checkout.session.completed,
#    customer.subscription.created, customer.subscription.updated,
#    customer.subscription.deleted, invoice.payment_failed)
STRIPE_WEBHOOK_SECRET=

# 4) Public origin used for Stripe's success/cancel redirects
APP_ORIGIN=http://localhost:5173

# Optional — always-active keys you hand out yourself (support, refunds, gifts)
# PRO_KEYS=IMP-AAAA-BBBB-CCCC,IMP-DDDD-EEEE-FFFF

# Optional — where purchases are stored (default: ./data/pro.json)
# PRO_STORE=./data/pro.json
